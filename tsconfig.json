{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "module": "preserve",
    "importHelpers": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "preserveWhitespaces": false,
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
